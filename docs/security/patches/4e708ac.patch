From 4e708ac9bcec3d97105b0f66bed1bba70fa7f11a Mon Sep 17 00:00:00 2001
From: Jan Schmitz <jan.schmitz@whu.edu>
Date: Mon, 11 May 2026 14:29:18 +0200
Subject: [PATCH] composer media asset removal improvement

---
 apps/composer/views.py                        |  4 ++-
 templates/composer/compose.html               | 25 ++++++-------------
 .../composer/partials/media_list_pending.html |  5 +++-
 3 files changed, 14 insertions(+), 20 deletions(-)

diff --git a/apps/composer/views.py b/apps/composer/views.py
index 7950dce8..32ea3004 100644
--- a/apps/composer/views.py
+++ b/apps/composer/views.py
@@ -1341,7 +1341,7 @@ def remove_pending_media(request, workspace_id, asset_id):
 
     # Return updated pending list
     pending_assets = MediaAsset.objects.filter(id__in=pending, workspace=workspace)
-    return render(
+    response = render(
         request,
         "composer/partials/media_list_pending.html",
         {
@@ -1349,6 +1349,8 @@ def remove_pending_media(request, workspace_id, asset_id):
             "workspace": workspace,
         },
     )
+    response["HX-Trigger"] = "previewUpdate"
+    return response
 
 
 @login_required
diff --git a/templates/composer/compose.html b/templates/composer/compose.html
index 37fb053b..5f6999be 100644
--- a/templates/composer/compose.html
+++ b/templates/composer/compose.html
@@ -1582,6 +1582,9 @@ <h3 class="text-base font-semibold text-stone-900 mb-1">Delete post?</h3>
         },
 
         onFormSaved(event) {
+            // Only react to the form's own submit, not htmx requests bubbling from
+            // child elements (e.g. the pending-media remove button).
+            if (event.detail.elt !== event.currentTarget) return;
             const xhr = event.detail.xhr;
             if (event.detail.successful) {
                 const action = document.getElementById('publish-action-btn')?.value;
@@ -1720,7 +1723,11 @@ <h3 class="text-base font-semibold text-stone-900 mb-1">Delete post?</h3>
                 if (xhr.status >= 200 && xhr.status < 300) {
                     // Replace the upload placeholder with the server-rendered thumb
                     thumb.insertAdjacentHTML('afterend', xhr.responseText);
+                    const inserted = thumb.nextElementSibling;
                     thumb.remove();
+                    if (inserted && window.htmx) {
+                        window.htmx.process(inserted.parentElement);
+                    }
                     if (self.autosavedPostId && !self.uploadUrl.includes(self.autosavedPostId)) {
                         self.uploadUrl = `/workspace/{{ workspace.id }}/compose/${self.autosavedPostId}/upload-media/`;
                     }
@@ -1785,24 +1792,6 @@ <h3 class="text-base font-semibold text-stone-900 mb-1">Delete post?</h3>
     };
 }
 
-async function removePendingMedia(assetId, url, btn) {
-    const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]')?.value
-        || document.cookie.match(/csrftoken=([^;]+)/)?.[1] || '';
-    try {
-        const resp = await fetch(url, {
-            method: 'POST',
-            headers: { 'X-CSRFToken': csrfToken },
-        });
-        if (resp.ok) {
-            const html = await resp.text();
-            document.getElementById('media-list').innerHTML = html;
-            document.body.dispatchEvent(new CustomEvent('previewUpdate'));
-        }
-    } catch (err) {
-        console.error('Remove failed:', err);
-    }
-}
-
 /* ── Publish Split-Button (vanilla JS) ────────────────────────── */
 (function() {
     const anchor = document.getElementById('publish-anchor');
diff --git a/templates/composer/partials/media_list_pending.html b/templates/composer/partials/media_list_pending.html
index e3ac3a1a..aba0df89 100644
--- a/templates/composer/partials/media_list_pending.html
+++ b/templates/composer/partials/media_list_pending.html
@@ -19,7 +19,10 @@
         <svg class="w-5 h-5 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
     </div>
     {% endif %}
-    <button type="button" class="remove-btn" onclick="event.preventDefault(); event.stopPropagation(); removePendingMedia('{{ asset.id }}', '{% url 'composer:remove_pending_media' workspace_id=workspace.id asset_id=asset.id %}', this)">
+    <button type="button" class="remove-btn"
+            hx-post="{% url 'composer:remove_pending_media' workspace_id=workspace.id asset_id=asset.id %}"
+            hx-target="#media-list"
+            hx-swap="innerHTML">
         <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>
     </button>
     <input type="hidden" name="pending_media_ids" value="{{ asset.id }}">
